{
  "version": 1,
  "project": {
    "name": "fixture-project",
    "required_context_files": [
      "AGENTS.md",
      "docs/PROJECT_STATUS.md"
    ]
  },
  "gates": {
    "audit_adjudication": {
      "enabled": true,
      "mode": "warn",
      "audit_skip_allowed": [
        "docs-only"
      ]
    },
    "evidence_closeout": {
      "enabled": true,
      "mode": "blocking"
    },
    "worktree": {
      "enabled": false,
      "mode": "off",
      "ci_mode": false
    }
  },
  "boundaries": {
    "production": {
      "require_explicit_statement": true
    },
    "secrets": {
      "require_explicit_statement": true
    },
    "raw_private_data": {
      "require_explicit_statement": true
    }
  }
}
